# TripAgent 环境变量模板（对齐 project.md §11.2）
# 用法：cp .env.example .env ，填入真实密钥。
# .env 已被 .gitignore 忽略，真实密钥永不入库；本文件只含空值/默认值，随仓库分发。

# --- LLM（B3：DeepSeek，OpenAI-compatible 端点，适配器保持可插拔）---
LLM_BASE_URL=https://api.deepseek.com
# 可用模型（2026-11 验证）：deepseek-v4-pro | deepseek-flash
LLM_MODEL=deepseek-v4-pro
LLM_API_KEY=

# --- 路由 / 距离矩阵（B7：默认读预计算 data/matrix.json，运行时零外部调用）---
# static（默认）| osrm | amap
ROUTING_PROVIDER=static
OSRM_BASE_URL=
# 高德 Web 服务 key：仅 0.4/0.5 一次性数据导出脚本使用，运行时不需要
AMAP_KEY=

# --- 数据与运行 ---
DATABASE_URL=sqlite:///./data/tripagent.db
EVAL_CASES_PATH=./data/eval_cases.jsonl
LOG_LEVEL=INFO
# 记忆注入开关（ADR-006 基线 B：off = 完整管线关闭记忆注入；默认 on）
MEMORY_INJECTION=on

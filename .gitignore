# --- 密钥与环境（真实密钥永不入库）---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# --- 本地数据库与运行时产物（data/ 下的数据集 json/jsonl 应入库）---
data/*.db
data/*.db-wal
data/*.db-shm

# --- 测试 / Lint 缓存 ---
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- IDE / OS ---
.idea/
.vscode/
.DS_Store
Thumbs.db
.zcode/

# --- 本地技术文档（个人笔记，不作为仓库证据链的一部分）---
docs/

# --- 教学工作区（/teach 上线工程课，个人学习材料，不入公开仓；audit 11-23 建议 #5）---
/MISSION.md
/NOTES.md
/RESOURCES.md
/assets/
/lessons/
/learning-records/
/reference/

# reports/ 是否入库：按 TASKS 0.1 另行决定；当前默认入库（评测报告是 §16 证据链的一部分），
